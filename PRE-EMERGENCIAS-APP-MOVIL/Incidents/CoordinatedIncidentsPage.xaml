<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PRE_EMERGENCIAS_APP_MOVIL.Incidents.CoordinatedIncidentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mis incidentes">
    <RefreshView x:Name="Refresher" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="20,24,20,120" Spacing="16">
                <Label
                    Text="Incidentes a mi cargo"
                    Style="{StaticResource Headline}"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Text="Incidentes activos que coordinas y todos los aportes recibidos."
                    HorizontalTextAlignment="Center" />
                <Button x:Name="RefreshButton" Text="Actualizar" Clicked="OnRefreshClicked" />
                <Label x:Name="StatusLabel" HorizontalTextAlignment="Center" />
                <VerticalStackLayout x:Name="IncidentsLayout" Spacing="12" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
