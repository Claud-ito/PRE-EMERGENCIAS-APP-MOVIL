<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PRE_EMERGENCIAS_APP_MOVIL.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Inicio">
    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="18">
            <Label
                Text="UNIVALLE Emergencias"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                Text="Conexión al servicio"
                FontSize="18"
                HorizontalTextAlignment="Center" />
            <Label
                Text="Ingresa la dirección del servidor y comprueba que esté disponible."
                HorizontalTextAlignment="Center" />

            <Border Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Dirección del servidor" FontAttributes="Bold" />
                    <Entry
                        x:Name="ApiUrlEntry"
                        Keyboard="Url"
                        Placeholder="https://servidor:puerto"
                        ClearButtonVisibility="WhileEditing"
                        SemanticProperties.Description="Dirección base de la API" />
                    <Button
                        x:Name="SaveButton"
                        Text="Guardar dirección"
                        Clicked="OnSaveClicked" />
                    <Button
                        x:Name="CheckButton"
                        Text="Comprobar conexión"
                        Clicked="OnCheckClicked" />
                    <ActivityIndicator
                        x:Name="BusyIndicator"
                        IsVisible="False"
                        IsRunning="False" />
                </VerticalStackLayout>
            </Border>

            <Label
                x:Name="StatusLabel"
                Text="Introduce una dirección para comenzar."
                HorizontalTextAlignment="Center"
                />
            <Label
                x:Name="TimeLabel"
                HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
